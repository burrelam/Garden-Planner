{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "scripts",
    "src/shared",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ]
}
